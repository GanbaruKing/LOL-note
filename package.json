{
  "name": "riftnote",
  "productName": "RiftNote",
  "version": "0.1.0",
  "private": true,
  "description": "An offline-first personal League of Legends matchup notebook",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/repository.test.ts tests/lcu.test.ts tests/history.test.ts tests/curated-counters.test.ts tests/knowledge.test.ts",
    "test:e2e": "npm run build && playwright test",
    "data:refresh": "node scripts/refresh-champions.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts docs *.json *.ts *.mjs README.md",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  },
  "author": "GanbaruKing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GanbaruKing/LOL-note.git"
  }
}
